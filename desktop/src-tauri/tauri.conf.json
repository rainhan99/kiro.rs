{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiro.rs",
  "version": "0.9.6",
  "identifier": "rs.kiro.desktop",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "title": "kiro.rs",
        "url": "waiting.html",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "MIT",
    "shortDescription": "kiro.rs 桌面版",
    "longDescription": "kiro.rs：Anthropic / OpenAI 协议到 Kiro 后端的代理，附带管理界面与对话功能。"
  }
}
